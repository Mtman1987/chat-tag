FROM node:20-alpine
WORKDIR /app
ARG GITHUB_SHA=unknown
ARG GH_SHA=unknown
ARG BUILD_SHA=unknown
LABEL org.opencontainers.image.revision=$GITHUB_SHA
LABEL com.github.sha=$GH_SHA
LABEL app.build_sha=$BUILD_SHA
LABEL GITHUB_SHA=$GITHUB_SHA
LABEL GH_SHA=$GH_SHA
LABEL BUILD_SHA=$BUILD_SHA
COPY package*.json ./
RUN npm ci --only=production
COPY bot.js ./
COPY scripts/lib/twitch-transport.cjs ./scripts/lib/twitch-transport.cjs
COPY scripts/lib/api-read-retry.cjs ./scripts/lib/api-read-retry.cjs
COPY scripts/lib/word-chain-lifecycle.cjs ./scripts/lib/word-chain-lifecycle.cjs
COPY scripts/patch-game-hub-bot.mjs ./scripts/patch-game-hub-bot.mjs
COPY scripts/patch-live-chat-pressure.mjs ./scripts/patch-live-chat-pressure.mjs
COPY scripts/patch-quackverse-pack-bot.mjs ./scripts/patch-quackverse-pack-bot.mjs
COPY src/lib/chat-tag-command-text.js ./src/lib/chat-tag-command-text.js
COPY src/lib/chat-tag-player-lookup.js ./src/lib/chat-tag-player-lookup.js
COPY src/lib/chat-tag-crowns.js ./src/lib/chat-tag-crowns.js
RUN node scripts/patch-game-hub-bot.mjs
RUN node scripts/patch-live-chat-pressure.mjs
RUN node scripts/patch-quackverse-pack-bot.mjs
RUN node -e "require('./src/lib/chat-tag-crowns'); require('./scripts/lib/api-read-retry.cjs')"
CMD ["node", "bot.js"]

